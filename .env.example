# Copy to .env (never commit .env). CI reads these from GitHub Actions secrets instead.

# Required: generator (gpt-4o-mini) and judge (gpt-4.1)
OPENAI_API_KEY=
# Only if generation.provider is set to anthropic in config/rag.yaml
ANTHROPIC_API_KEY=

# Optional: Langfuse tracing. Leave empty to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: Qdrant Cloud for the deployed service. Leave empty to use the local embedded index.
QDRANT_URL=
QDRANT_API_KEY=
